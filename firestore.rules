rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "cikastore3.0@gmail.com";
    }

    match /links/{linkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
